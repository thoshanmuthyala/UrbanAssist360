# Copy to .env only if you use a local shell to upload data. The SQL runbook does
# not read this file and Snowflake credentials must never be committed.
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-your-bucket
S3_PREFIX=urbanassist
SNOWFLAKE_ACCOUNT=replace-with-org-account
SNOWFLAKE_USER=replace-with-user
SNOWFLAKE_ROLE=URBANASSIST_ENGINEER
SNOWFLAKE_WAREHOUSE=URBANASSIST_WH

